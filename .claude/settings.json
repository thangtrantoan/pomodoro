{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "ask": [
      "Bash(npm test*)",
      "Bash(npx jest*)",
      "Bash(npm run lint*)",
      "Bash(npx eslint*)",
      "Bash(npm run format*)",
      "Bash(npx prettier*)",
      "PowerShell(npm test*)",
      "PowerShell(npx jest*)",
      "PowerShell(npm run lint*)",
      "PowerShell(npx eslint*)",
      "PowerShell(npm run format*)",
      "PowerShell(npx prettier*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/log-task.js"],
            "timeout": 15,
            "statusMessage": "Ghi task log"
          }
        ]
      }
    ]
  }
}
